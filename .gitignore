# ==========================================================
# TrafficEnforceNet - Git Ignore
# ==========================================================

# Laravel environment / secrets
.env
.env.backup
.env.production

# Laravel logs / runtime files
*.log
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/pail
/storage/*.key

# Laravel generated public storage
/public/storage

# Laravel compiled assets
/public/build
/public/hot

# Dependencies
/vendor
/node_modules

# PHPUnit / testing cache
.phpunit.result.cache
/.phpunit.cache

# PHP / IDE tooling
.phpactor.json
/auth.json

# IDEs / editors
/.fleet
/.idea
/.nova
/.vscode
/.zed

# OS generated files
.DS_Store
Thumbs.db

# Homestead
Homestead.json
Homestead.yaml